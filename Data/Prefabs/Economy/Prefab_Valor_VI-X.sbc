    <Prefab xsi:type="MyObjectBuilder_PrefabDefinition">
      <Id Type="MyObjectBuilder_PrefabDefinition" Subtype="Prefab_Valor_VI-X" />
        <DisplayName>Valor VI-X</DisplayName>
        <Description>A robust, armed dropship capable of transporting up to 10 passengers and a pilot in style. Equipped with twin-linked assault cannons, and a spacious cargo bay, the Valor VI-X is ready for any challenge. Its advanced life support systems and airtight cockpit ensure survival in hostile environments. Land safely on any planet with extended landing gear and enjoy smooth flight in up to 1.3g gravity.</Description>
        <Icon>Textures\GUI\Icons\VIX Prefabs\Valor_VI-X.dds</Icon>
        <TooltipImage>Textures\GUI\Icons\VIX Prefabs\Valor_VI-X_Tooltip.png</TooltipImage>
        <EnvironmentType>All</EnvironmentType>
