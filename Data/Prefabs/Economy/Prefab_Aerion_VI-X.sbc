      <Id Type="MyObjectBuilder_PrefabDefinition" Subtype="Prefab_Aerion_VI-X" />
        <DisplayName>Aerion VI-X</DisplayName>
        <Description>The Aerion VI-X is a nimble and aggressive fighter craft, designed for swift strikes and tactical superiority. Armed with a quartet of Gatling guns for suppressing enemy fire and a pair of potent rocket launchers for delivering devastating blows, this vessel is a force to be reckoned with. Equipped with a rear-mounted decoy system, the Aerion VI-X can confuse and evade even the most determined pursuers.</Description>
        <Icon>Textures\GUI\Icons\VIX Prefabs\Aerion_VI-X.dds</Icon>
        <TooltipImage>Textures\GUI\Icons\VIX Prefabs\Aerion_VI-X_Tooltip.png</TooltipImage>
        <EnvironmentType>PlanetWithAtmosphere</EnvironmentType>
