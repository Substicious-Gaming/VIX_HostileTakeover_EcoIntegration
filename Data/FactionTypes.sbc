<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <!-- Example

    This file defines properties for a dynamically generated factions.

    Any faction types in this file also need corresponding definitions in the following files to avoid errors:
        - FactionNames.sbc
        - FactionIconTextures.sbc

    <Definition xsi:type="MyObjectBuilder_FactionTypeDefinition">
        <Id Type="MyObjectBuilder_FactionTypeDefinition" Subtype="FactionSubtype" /> The subtype of the faction. Used in Factions.sbc

        <FactionRatio>4</FactionRatio>   Ratio of how many factions of this type shsould be generated. Split to 15 by default.
        <Station_Rule_Min_Outpost>2</Station_Rule_Min_Outpost>   Minimum number of planetary trade stations
        <Station_Rule_Max_Outpost>4</Station_Rule_Max_Outpost>   Maximum number of planetary trade stations
        <Station_Rule_Min_Orbit>1</Station_Rule_Min_Orbit>   Minimum number of orbital trade stations
        <Station_Rule_Max_Orbit>2</Station_Rule_Max_Orbit>   Maximum number of orbital trade stations
        <Station_Rule_Min_Station>1</Station_Rule_Min_Station>   Minimum number of space trade stations
        <Station_Rule_Max_Station>2</Station_Rule_Max_Station>   Maximum number of space trade stations
        <PreferDeep>true</PreferDeep>   Spawn deep space stations
        
        <Relations>
            <Relation Faction="Miner" Variant="HostileMin" />   Example: Hostile relations with factions of this type
            <Relation Faction="Trader" Variant="HostileMin_NeutralMid" />   Example: Hostile to Neutral relations with factions of this type
            <Relation Faction="Builder" Variant="FriendlyMax_HostileMid" />   Example: Neutral to Friendly relations with factions of this type
            <Relation Faction="Military" Variant="Zero" />   Example: Neutral relations with factions of this type
        </Relations>
        <FriendsWith>   Become friends with the closest proximity of these spawned faction types.
            <Faction>Trader</Faction>   List of any factions applicable
        </FriendsWith>
        
        <TypeDescription>EconomyFaction_Description_Miner</TypeDescription>   Localization tag for faction description
        <TypeDescriptionVariants>5</TypeDescriptionVariants>   How many variations are there? TypeDescription, TypeDescription0, TypeDescription1 etc. See localization file.
        
        <OffersList>   Items available to buy at their stations stores
            <ItemId Type="MyObjectBuilder_Ore" Subtype="Iron" />
            <ItemId Type="MyObjectBuilder_Ore" Subtype="Nickel" />
            <ItemId Type="MyObjectBuilder_Ore" Subtype="Cobalt" />
        </OffersList>

        <OrdersList>   Items their stations are willing to buy
            <ItemId Type="MyObjectBuilder_Component" Subtype="SteelPlate" />
            <ItemId Type="MyObjectBuilder_Component" Subtype="Construction" />
            <ItemId Type="MyObjectBuilder_Component" Subtype="Detector" />
            <ItemId Type="MyObjectBuilder_Component" Subtype="Motor" />
            <ItemId Type="MyObjectBuilder_Component" Subtype="Computer" />
            <ItemId Type="MyObjectBuilder_Component" Subtype="LargeTube" />
        </OrdersList>
        
        <GridsForSale>  prefabs/ships Available to buy at station stores.
            <PrefabName>Eco_Ship_TIonFade</PrefabName>
            <PrefabName>Eco_Ship_MiniMerchant</PrefabName>
            <PrefabName>Eco_Ship_JClassCourier</PrefabName>
            <PrefabName>Eco_Ship_B60BulkFreighter</PrefabName>
            <PrefabName>Eco_Ship_AmbassadorExplorer</PrefabName>
            <PrefabName>Eco_Ship_H2BullwarkHauler</PrefabName>
            <PrefabName>Eco_Ship_CR2Shrike</PrefabName>
            <PrefabName>Eco_Ship_LightSupplyCraft</PrefabName>
            <PrefabName>Eco_Ship_BuddyMiner</PrefabName>
            <PrefabName>Eco_Ship_WaylineSutler</PrefabName>
            <PrefabName>Eco_Ship_HF3NarrowframeFreighter</PrefabName>
            <PrefabName>Eco_Ship_RhinoMiner</PrefabName>
            <PrefabName>Eco_Ship_RST6Salvador</PrefabName>
            <PrefabName>Eco_Ship_RookGunship</PrefabName>
            <PrefabName>Eco_Ship_H01Sapper</PrefabName>
            <PrefabName>Eco_Rover_LunarScoutMk6</PrefabName>
            <PrefabName>Eco_Ship_R3StartSkiff</PrefabName>
            <PrefabName>Eco_Ship_H01Prospector</PrefabName>
            <PrefabName>Eco_Ship_HullBreaker</PrefabName>
            <PrefabName>Eco_Rover_LunarScoutMk2</PrefabName>
            <PrefabName>Eco_Missile_LM3LateralMissile</PrefabName>
            <PrefabName>Eco_Ship_CivicHauler</PrefabName>
            <PrefabName>Eco_Ship_TurtleMiner</PrefabName>
            <PrefabName>Eco_Ship_KiteMiner</PrefabName>
            <PrefabName>Eco_Ship_H04Advanced</PrefabName>
            <PrefabName>Eco_Ship_HeavyModuleFreighter</PrefabName>
            <PrefabName>Eco_Ship_HorizonForge</PrefabName>
            <PrefabName>Eco_Ship_LunarArk</PrefabName>
            <PrefabName>Eco_Ship_HaulFrameC</PrefabName>
            <PrefabName>Eco_Ship_HaulFrameJ</PrefabName>
            <PrefabName>Eco_Ship_B980Hauler</PrefabName>
            <PrefabName>Eco_Ship_WardenStrikeCraft</PrefabName>
            <PrefabName>Eco_Ship_TwinRailDrone</PrefabName>
            <PrefabName>Eco_Ship_Jackdaw</PrefabName>
            <PrefabName>Eco_Ship_SnubShip</PrefabName>
            <PrefabName>Eco_Ship_H1IndustrialCorvette</PrefabName>
            <PrefabName>Eco_Rover_OR7Gravler</PrefabName>
            
            <PrefabName>Eco_Ship_Pirate_MiniMerchant</PrefabName>
            <PrefabName>Eco_Ship_Pirate_JClassCourier</PrefabName>
            <PrefabName>Eco_Ship_Pirate_CR2Shrike</PrefabName>
            <PrefabName>Eco_Ship_Pirate_RookGunship</PrefabName>
            <PrefabName>Eco_Ship_Pirate_HullBreaker</PrefabName>
            <PrefabName>Eco_Ship_Pirate_HaulFrameJ</PrefabName>
        </GridsForSale>

        <CanSellOxygen>true</CanSellOxygen>   When true trade stations can sell Oxygen
        <CanSellHydrogen>true</CanSellHydrogen>   When true trade stations can sell Hydrogen	
		<MinimumOfferGasAmount>5000</MinimumOfferGasAmount>   The minimum amount of oxygen/hydrogen for sale - this value is in KL
		<MaximumOfferGasAmount>45000</MaximumOfferGasAmount>   The maximum amount of oxygen/hydrogen for sale - this value is in KL
		<MinimumOxygenPrice>150</MinimumOxygenPrice>   The minimum price for oxygen
		<MinimumHydrogenPrice>150</MinimumHydrogenPrice>   The minimum price for hydrogen

        <MaxContractCount>15</MaxContractCount>   Maximum number of contract jobs available at their stations
    </Definition>

-->

    <Definition xsi:type="MyObjectBuilder_FactionTypeDefinition">
        <Id Type="MyObjectBuilder_FactionTypeDefinition" Subtype="Miner" />

        <FactionRatio>4</FactionRatio>
        <Station_Rule_Min_Outpost>2</Station_Rule_Min_Outpost>
        <Station_Rule_Max_Outpost>4</Station_Rule_Max_Outpost>
        <Station_Rule_Min_Orbit>1</Station_Rule_Min_Orbit>
        <Station_Rule_Max_Orbit>2</Station_Rule_Max_Orbit>
        <Station_Rule_Min_Station>1</Station_Rule_Min_Station>
        <Station_Rule_Max_Station>2</Station_Rule_Max_Station>
        <PreferDeep>false</PreferDeep>

        <Relations>
            <Relation Faction="Miner" Variant="HostileMin_NeutralMid" />
            <Relation Faction="Trader" Variant="FriendlyMax_HostileMid" />
            <Relation Faction="Builder" Variant="Zero" />
            <Relation Faction="Military" Variant="Zero" />
            <Relation Faction="Pirate" Variant="HostileMin_NeutralMid" />
        </Relations>
        <FriendsWith>
            <Faction>Trader</Faction>
        </FriendsWith>

        <TypeDescription>EconomyFaction_Description_Miner</TypeDescription>
        <TypeDescriptionVariants>5</TypeDescriptionVariants>

        <OffersList>
            <ItemId Type="MyObjectBuilder_Ore" Subtype="Iron" />
