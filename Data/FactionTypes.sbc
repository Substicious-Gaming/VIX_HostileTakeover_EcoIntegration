            <PrefabName>Eco_Ship_B980Hauler</PrefabName>
            <PrefabName>Eco_Rover_OR7Gravler</PrefabName>

        </GridsForSale>

        <CanSellOxygen>true</CanSellOxygen>
        <CanSellHydrogen>true</CanSellHydrogen>
		<MinimumOfferGasAmount>5000</MinimumOfferGasAmount>
		<MaximumOfferGasAmount>45000</MaximumOfferGasAmount>

        <MaxContractCount>25</MaxContractCount>

    </Definition>

